#!/usr/bin/env bash
[[ ! ${WARDEN_DIR} ]] && >&2 echo -e "\033[31mThis script is not intended to be run directly!\033[0m" && exit 1

WARDEN_USAGE=$(cat <<USAGE
\033[33mUsage:\033[0m
  app                       Open a bash shell in the ledger app container
  app COMMAND               Run any command inside the app container, e.g. app npm ci

\033[33mOptions:\033[0m
  -h, --help        Display this help menu
USAGE
)
